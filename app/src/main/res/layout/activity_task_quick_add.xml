<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 5: voice-first quick add screen launched from the widget.
     Starts listening immediately when mic permission is held; typing is the
     always-visible fallback. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:padding="24dp">

    <TextView
        android:id="@+id/quick_add_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:text="Listening… say your reminder."
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/quick_add_spinner"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Typing fallback — visible from the start; voice stays primary. -->
    <EditText
        android:id="@+id/quick_add_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint='Type instead — e.g. "remind me to call mom at 5pm"'
        android:textColorHint="#9E9E9E"
        android:textColor="#FFFFFF"
        android:maxLines="2"
        android:imeOptions="actionDone"
        android:inputType="text" />

    <Button
        android:id="@+id/quick_add_send"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Add task" />

</LinearLayout>
