<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 5: task reminder AppWidget info.
     updatePeriodMillis=0 on purpose — the widget is refreshed ONLY by
     TaskWidgetSync.updateAll() calls from task mutations (create / fire /
     done / snooze / boot) plus the system's onUpdate on placement. No
     polling, no service, no timer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="72dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_task_reminder"
    android:previewLayout="@layout/widget_task_reminder"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
