<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 5: task widget background — dark rounded panel.
     Upgraded to a subtle vertical gradient + hairline stroke for depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/zara_widget_bg_grad_top"
                android:endColor="@color/zara_widget_bg_grad_bottom"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/zara_stroke" />
        </shape>
    </item>
</layer-list>
